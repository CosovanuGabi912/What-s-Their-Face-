# Copy to .env and edit. Every variable is optional: config.py has a default for each.

# LM Studio (OpenAI-compatible server)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Model IDs as LM Studio names them
AGENT_MODEL=qwen3-4b
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
VISION_MODEL=qwen2.5-vl-3b

# Paths (relative paths are resolved against the repository root)
# Where the UI saves uploaded photos as <image_id>; eval/run_eval.py points this at eval/images
WTF_IMAGE_UPLOAD_DIR=data/uploads
WTF_CHROMA_KNOWLEDGE_DIR=data/chroma_knowledge
WTF_CHROMA_LISTINGS_DIR=data/chroma_listings
# JSON tool-call traces (one file per conversation)
WTF_LOG_DIR=logs

# Serve these tools from mcp_server/tools/stubs.py (fixed sample data): a comma list such as
# identify_breed,describe_pet (no classifier weights on this laptop), or "all" for UI work.
WTF_STUB_TOOLS=
